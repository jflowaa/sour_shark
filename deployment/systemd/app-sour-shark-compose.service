[Unit]
Description=sour-shark compose stack
Wants=network-online.target
After=network-online.target platform-compose.service
Requires=platform-compose.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/apps/sour-shark
ExecStart=/usr/bin/podman-compose -p sour-shark up -d --remove-orphans
ExecStop=/usr/bin/podman-compose -p sour-shark down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
