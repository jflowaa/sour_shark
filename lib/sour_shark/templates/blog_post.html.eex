<div class="mx-auto w-full max-w-3xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
  <a href="/" class="inline-flex items-center gap-2 text-sm font-medium text-base-content/60 transition-colors hover:text-primary">
    <svg class="h-3.5 w-3.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
      <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5H1m0 0l4-4M1 5l4 4" />
    </svg>
    All writing
  </a>

  <header class="mt-6 border-b border-base-300 pb-8">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-base-content/55">
      <span class="badge badge-outline badge-sm font-medium"><%= @post.category %></span>
      <%= if @post.date do %>
        <span><%= Calendar.strftime(@post.date, "%B %-d, %Y") %></span>
      <% end %>
      <span aria-hidden="true">&middot;</span>
      <span><%= SourShark.Blog.reading_time(@post) %> min read</span>
    </div>
    <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl"><%= @post.title %></h1>
    <p class="mt-3 text-lg leading-relaxed text-base-content/70"><%= @post.description %></p>
    <%= if @post.tags != [] do %>
      <div class="mt-5 flex flex-wrap gap-2">
        <%= for tag <- @post.tags do %>
          <a href="/?tag=<%= URI.encode_www_form(String.downcase(tag)) %>" class="rounded-full bg-base-200 px-2.5 py-1 text-xs font-medium text-base-content/60 transition-colors hover:bg-base-300 hover:text-base-content"><%= tag %></a>
        <% end %>
      </div>
    <% end %>
  </header>

  <nav id="table-of-contents" aria-label="Table of contents" class="my-8 hidden rounded-2xl border border-base-300 bg-base-200/40 p-5">
    <p class="text-sm font-semibold uppercase tracking-wide text-base-content/50">On this page</p>
    <div id="table-of-contents-list" class="mt-3 space-y-1.5 text-sm"></div>
  </nav>

  <article
    id="blog-article"
    class="prose max-w-none leading-relaxed prose-headings:font-semibold prose-headings:tracking-tight prose-img:rounded-xl prose-pre:shadow prose-pre:!bg-base-200 prose-pre:!p-4 prose-pre:rounded-box prose-blockquote:border-l-4 prose-blockquote:border-primary prose-blockquote:italic prose-a:link">
    <%= @post_body %>
  </article>

  <div class="mt-12 border-t border-base-300 pt-6">
    <a href="/" class="inline-flex items-center gap-2 text-sm font-medium text-base-content/60 transition-colors hover:text-primary">
      <svg class="h-3.5 w-3.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5H1m0 0l4-4M1 5l4 4" />
      </svg>
      Back to all writing
    </a>
  </div>
</div>

<style>
  #blog-article h1 { font-size: clamp(2rem, 4vw, 2.5rem); line-height:1.2; margin-top:2.75rem; margin-bottom:1.25rem; }
  #blog-article h2 { font-size: clamp(1.6rem, 3.5vw, 2rem); line-height:1.25; margin-top:2.5rem; margin-bottom:1rem; }
  #blog-article h3 { font-size: clamp(1.35rem, 2.5vw, 1.6rem); line-height:1.3; margin-top:2rem; margin-bottom:0.75rem; }
  #blog-article h4 { font-size:1.2rem; line-height:1.4; margin-top:1.75rem; margin-bottom:0.5rem; }
  #blog-article h5 { font-size:1.05rem; line-height:1.4; margin-top:1.5rem; margin-bottom:0.5rem; }
  #blog-article h6 { font-size:0.95rem; line-height:1.4; margin-top:1.25rem; margin-bottom:0.5rem; }
  #blog-article h1, #blog-article h2, #blog-article h3, #blog-article h4 { scroll-margin-top: 5rem; }
  .hide-path-line span.__path_label_removed { display:none; }
  /* Force list markers & indentation (overrides DaisyUI reset that hides bullets) */
  #blog-article ul, #blog-article ol { list-style-position: outside; margin-top:1.25em; margin-bottom:1.25em; padding-left:1.5rem; }
  #blog-article ul { list-style-type: disc; }
  #blog-article ol { list-style-type: decimal; }
  #blog-article ul ul { list-style-type: circle; margin-top:0.75em; margin-bottom:0.75em; }
  #blog-article ol ul, #blog-article ul ol, #blog-article ol ol { margin-top:0.75em; margin-bottom:0.75em; }
  #blog-article li { margin-top:0.25em; margin-bottom:0.25em; }
  #blog-article ul>li::marker { color: var(--tw-prose-bullets); }
  #blog-article ol>li::marker { color: var(--tw-prose-counters); }
  /* Improve link visibility & accessibility */
  #blog-article a { color: var(--color-primary); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 2px; font-weight: 500; transition: color .15s ease, background-color .15s ease, text-decoration-color .15s ease; }
  #blog-article a:hover, #blog-article a:focus-visible { color: color-mix(in oklch, var(--color-primary) 85%, var(--color-base-content)); text-decoration-color: currentColor; }
  #blog-article a:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; border-radius: 2px; }
  #blog-article a code { color: inherit; }
  /* Do NOT restyle links that wrap entire headings (keep heading typography) */
  #blog-article h1>a, #blog-article h2>a, #blog-article h3>a, #blog-article h4>a, #blog-article h5>a, #blog-article h6>a {
    color: inherit !important;
    text-decoration: none !important;
    font-weight: inherit !important;
  }
  #blog-article h1>a:hover, #blog-article h2>a:hover, #blog-article h3>a:hover,
  #blog-article h4>a:hover, #blog-article h5>a:hover, #blog-article h6>a:hover {
    text-decoration: none;
  }
</style>
<script>
  (function() {
    function applyProseTheme() {
      const theme = document.documentElement.getAttribute('data-theme');
      const dark = theme === 'sour-dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
      const article = document.getElementById('blog-article');
      if (!article) return;
      article.classList.toggle('prose-invert', dark);
    }
    applyProseTheme();
    new MutationObserver(applyProseTheme).observe(document.documentElement, { attributes:true, attributeFilter:['data-theme'] });

    // Build a clean table of contents from the article headings only.
    function buildTableOfContents() {
      const container = document.getElementById('table-of-contents');
      const list = document.getElementById('table-of-contents-list');
      const article = document.getElementById('blog-article');
      if (!container || !list || !article) return;

      const headings = Array.from(article.querySelectorAll('h1, h2, h3, h4'));
      if (headings.length < 3) return;

      const used = new Set();
      headings.forEach((heading) => {
        const base = heading.textContent
          .toLowerCase()
          .trim()
          .replace(/[^\w\s-]/g, '')
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-')
          .replace(/^-|-$/g, '') || 'section';
        let id = base;
        let n = 2;
        while (used.has(id)) {
          id = `${base}-${n++}`;
        }
        used.add(id);
        heading.id = id;

        const link = document.createElement('a');
        link.href = `#${id}`;
        link.textContent = heading.textContent;
        link.className = 'block rounded-md py-0.5 text-base-content/65 transition-colors hover:text-primary';
        const level = Number(heading.tagName.slice(1));
        link.style.paddingLeft = `${(level - 1) * 0.75}rem`;
        list.appendChild(link);
      });

      container.classList.remove('hidden');
    }
    buildTableOfContents();

    const THRESHOLD = 10;

    // Get label from first line if starts with `#`, HTML comment <!-- label -->, or // label
    function extractCodeBlockLabel(codeEl) {
      const raw = codeEl.textContent.replace(/\r/g,'');
      const lines = raw.split('\n');
      if (!lines.length) return null;
      const first = lines[0].trim();
      if (!first) return null;
      const htmlCommentMatch = first.match(/^<!--\s*([!*~_A-Za-z0-9 .,\/\\:;#@(){}\-+\[\]|`'"?=&%]+)\s*-->$/);
      if (htmlCommentMatch) {
        let inner = htmlCommentMatch[1].trim();
        inner = inner.replace(/^\*+|\*+$/g,'').trim();
        return inner || null;
      }
      const slCommentMatch = first.match(/^\/\/\s*(.+)$/);
      if (slCommentMatch) {
        let inner = slCommentMatch[1].trim();
        inner = inner.replace(/^\*+|\*+$/g,'').trim();
        return inner || null;
      }
      const firstChar = first[0];
      if (firstChar == '#')
        return first.slice(1).trim();
      return null;
    }

    // Iterate code blocks
    document.querySelectorAll('#blog-article pre code').forEach(code => {
      let label = extractCodeBlockLabel(code);
      let text = code.textContent.replace(/\r/g,'');
      let lines = text.split('\n');
      let hasPathLine = false;
      if (label) {
        const first = lines[0].trim();
        if (/^(?:#|\/\/|--|;|%|<!--)\s*path:/i.test(first)) {
          hasPathLine = true;
          lines = lines.slice(1);
        }
      }
      const lineCount = lines.filter(l => l.length > 0 || !hasPathLine).length;
      const pre = code.parentElement;

      if (lineCount > THRESHOLD) {
        const details = document.createElement('details');
        details.className = 'mb-6 rounded-box border border-base-300 bg-base-100 open:shadow';
        const summary = document.createElement('summary');
        summary.className = 'cursor-pointer select-none rounded-t-box bg-base-200 px-4 py-2 font-medium';
        summary.textContent = `${label || 'Code block'} (${lineCount} lines)`;
        pre.replaceWith(details);
        details.appendChild(summary);
        pre.classList.add('mt-0','overflow-x-auto','p-0','bg-transparent','rounded-b-box');
        pre.style.margin = '0';
        code.classList.add('block','p-4','text-sm','leading-snug');
        details.appendChild(pre);
      }
    });
  })();
</script>
