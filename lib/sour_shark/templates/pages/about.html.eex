<section class="mx-auto w-full max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
  <div class="grid gap-10 lg:grid-cols-[1fr_18rem] lg:gap-16">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">About</p>
      <div class="mt-6 space-y-4 text-lg leading-relaxed text-base-content/75">
        <p>
          I write software, love exploring new technologies, and building stuff. This site is a collection of my thoughts, notes, and the projects I've been tinkering with.
        </p>
        <p>
          Most of what I build ends up here or on GitHub. If you want to chat feel free to reach out.
        </p>
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/resume" class="btn btn-primary btn-sm">View my resume</a>
      </div>
    </div>

    <aside class="h-fit rounded-2xl border border-base-300 bg-base-200/40 p-6 lg:mt-16">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/50">Get in touch</h2>
      <a href="mailto:<%= Application.get_env(:sour_shark, :contact_email) %>" class="mt-3 inline-flex items-center gap-2 font-medium text-primary hover:underline">
        <svg class="h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
        </svg>
        <%= Application.get_env(:sour_shark, :contact_email) %>
      </a>
      <a href="https://github.com/jflowaa" target="_blank" rel="noopener" class="mt-3 flex items-center gap-2 font-medium text-base-content/70 hover:text-base-content">
        <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 007.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.7.08-.7 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.75.4-1.27.73-1.56-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 015.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.26 5.69.41.35.78 1.05.78 2.12v3.14c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12C23.5 5.73 18.27.5 12 .5z" />
        </svg>
        github.com/jflowaa
      </a>
    </aside>
  </div>
</section>
