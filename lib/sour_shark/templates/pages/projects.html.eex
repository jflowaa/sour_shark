<section class="mx-auto w-full max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
  <header class="max-w-2xl">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">Projects</p>
    <p class="mt-4 text-lg leading-relaxed text-base-content/70">
      Things I've built in my free time to learn something new, scratch an itch, or just pass the time.
    </p>
  </header>

  <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    <%= for project <- [
      %{
        title: "This Site",
        description: "This is the site you're currently on. It's a static site that houses stuff related to me or my projects.",
        source_url: "https://www.github.com/jflowaa/sour_shark",
        project_url: "https://jack-develops.com/"
      },
      %{
        title: "Plank Games",
        description: "First code base written in Elixir/Phoenix. It's a small collection of games that are multiplayer. Driven by Phoenix LiveView and GenServers.",
        source_url: "https://github.com/jflowaa/blue_mint",
        project_url: "https://blue-mint.jack-develops.com/"
      },
      %{
        title: "Dev Tool Belt",
        description: "The idea of this project was to create a collection of tools used by developers. It's a work in process, and I don't work on it.",
        source_url: "https://github.com/jflowaa/wavy_bird",
        project_url: "https://wavy-bird.jack-develops.com/"
      },
      %{
        title: "Bluesky Metrics",
        description: "A project created to try out HTMx and not Phoenix for a simple web site. It uses metrics from Bluesky firehose to display posts created.",
        source_url: "https://github.com/jflowaa/icky_venus",
        project_url: "https://icky-venus.jack-develops.com/"
      },
      %{
        title: "Hacker News Job Aggregator",
        description: "Scrapes the who's hiring threads on Hacker News and uses Gemini to summarize the posts. Built with Elixir, Phoenix, and GenStage",
        source_url: "https://github.com/jflowaa/turbo_falcon",
        project_url: "https://turbo-falcon.jack-develops.com/"
      },
      %{
        title: "Flip 7 Scorecard",
        description: "Score keeper for the Flip 7 card game. Built with Elixir and Phoenix LiveView.",
        source_url: "https://github.com/jflowaa/shiny_wings",
        project_url: "https://flip7.jack-develops.com/"
      },
      %{
        title: "Kaikou",
        description: "A mobile-first web app for learning to speak Traditional Mandarin. Each level ends with a spoken quiz using the browser's speech recognition. Built with Go.",
        source_url: "https://github.com/jflowaa/flat_hill",
        project_url: "https://kaikou.jack-develops.com/"
      },
      %{
        title: "Apple Pie",
        description: "A credential broker and token vault with a Razor Pages and HTMX console. Built with .NET and PostgreSQL, with separate control and data planes.",
        source_url: "https://github.com/jflowaa/apple_pie",
        project_url: "https://apple-pie-console.jack-develops.com/"
      },
      %{
        title: "Lumpy",
        description: "A deterministic workflow execution engine. Workflows are compiled into validated plans and run with durable per-run state, using a Rust and QuickJS sandbox for user-authored JavaScript. Built with Elixir, Phoenix, and Rust.",
        source_url: "https://github.com/jflowaa/lumpy",
        project_url: "https://lumpy.jack-develops.com/"
      }
    ] do %>
      <article class="group flex h-full flex-col rounded-2xl border border-base-300 bg-base-100 p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-lg hover:shadow-base-content/5">
        <div class="flex items-start justify-between gap-3">
          <h2 class="text-lg font-semibold tracking-tight"><%= project.title %></h2>
          <a href="<%= project.project_url %>" target="_blank" rel="noopener" class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-base-200 text-base-content/60 transition-colors group-hover:bg-primary group-hover:text-primary-content" aria-label="Visit <%= project.title %>">
            <svg class="h-3.5 w-3.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9" />
            </svg>
          </a>
        </div>
        <p class="mt-2.5 text-sm leading-relaxed text-base-content/70"><%= project.description %></p>
        <div class="mt-auto flex items-center gap-4 pt-5 text-sm font-medium">
          <a href="<%= project.project_url %>" target="_blank" rel="noopener" class="text-primary underline-offset-4 hover:underline">Visit</a>
          <a href="<%= project.source_url %>" target="_blank" rel="noopener" class="text-base-content/60 underline-offset-4 transition-colors hover:text-base-content hover:underline">Source code</a>
        </div>
      </article>
    <% end %>
  </div>
</section>
